{
  "name": "maintenance-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app-cliente",
    "build": "ng build app-cliente && ng build app-taller && ng build app-almacen",
    "watch": "ng build --watch --configuration development",
    "test": "ng test app-cliente",
    "test:ci": "ng test app-cliente --watch=false --browsers=ChromeHeadless && ng test app-taller --watch=false --browsers=ChromeHeadless && ng test app-almacen --watch=false --browsers=ChromeHeadless",
    "test:coverage": "ng test app-cliente --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint app-cliente && ng lint app-taller && ng lint app-almacen",
    "start:taller": "ng serve app-taller",
    "start:almacen": "ng serve app-almacen",
    "build:site": "npm run build && ./scripts/assemble-site.sh"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.30",
    "@angular/cli": "^20.3.30",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}